{
  "http_server": {
    "address": "127.0.0.1",
    "port": "8001"
  },
  "client": {
    "token": {
      "hmac_secret_key": "<CENTRIFUGO_HMAC_SECRET>"
    },
    "allowed_origins": ["https://app.reklamamarket.uz"]
  },
  "http_api": {
    "key": "<CENTRIFUGO_API_KEY>"
  },
  "channel": {
    "namespaces": [
      {
        "name": "live",
        "presence": true
      },
      {
        "name": "user"
      }
    ]
  },
  "rpc": {
    "proxy": {
      "endpoint": "https://api.reklamamarket.uz/api/v1/centrifugo/rpc",
      "timeout": "5s",
      "http": {
        "static_headers": {
          "X-Centrifugo-Proxy-Secret": "<CENTRIFUGO_PROXY_SECRET>"
        }
      }
    },
    "without_namespace": {
      "proxy_enabled": true
    }
  }
}
