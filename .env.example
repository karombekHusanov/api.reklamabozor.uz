APP_NAME="Reklama Bozor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=adspace
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=8631368116:AAFw0eeT20cr0W3LsTrTAAOEkcP6OKa-Ct0
TELEGRAM_INIT_DATA_MAX_AGE=86400

TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_MINI_APP_URL=

# Ops-guruh (Telegram): bot marketplace eventlarini shu chatga yozadi. Bo'sh = o'chiq.
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_EVENTS=*

# Verify Telegram Mini App initData HMAC on login (keep true in production;
# set false only for local dev without a real Telegram client).
TELEGRAM_VERIFY_INIT_DATA=true

# Order payments: business-level settings, gateway-independent. Client pays by
# cash or bank transfer; a manager confirms it (or Kapitalbank
# auto-reconciliation matches a bank transfer automatically, below).
PAYMENTS_ENABLED=true
COMMISSION_PERCENT=7
PAYMENT_DUE_DAYS=3
PAYOUT_ADVANCE_PERCENT=40

# Kapitalbank (bank24.uz) OpenAPI — GetDoc1C (read-only statement polling) to
# auto-match incoming bank transfers to a pending Payment by contract number.
# KAPITALBANK_ENABLED=false keeps bank-transfer payments admin-confirmed only.
KAPITALBANK_ENABLED=false
KAPITALBANK_BASE_URL=https://m.bank24.uz:2713/Mobile.svc
KAPITALBANK_LOGIN=
KAPITALBANK_PASSWORD=
KAPITALBANK_BRANCH=
KAPITALBANK_ACCOUNT=
KAPITALBANK_POLL_LOOKBACK_DAYS=1

# SendPaymentIBK — queues agent payouts as unsigned orders in Kapitalbank's
# internet-bank system (a manager still signs/sends them on the bank's
# website). Needs PAYOUT_BANK_QUEUE_ENABLED=true AND KAPITALBANK_ENABLED above.
# purp_code has no published value list — confirm with the bank first.
PAYOUT_BANK_QUEUE_ENABLED=false
KAPITALBANK_CLIENT_ID=
KAPITALBANK_SENDER_NAME=
KAPITALBANK_SENDER_INN=
KAPITALBANK_PAYOUT_PURPOSE_CODE=
KAPITALBANK_PAYOUT_DOCUMENT_TYPE=01
KAPITALBANK_PAYOUT_ANOR=true


# AI assistant (any OpenAI-compatible endpoint; key stays server-side)
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL="minimax/minimax-m3:free"
ASSISTANT_TIMEOUT=20
ASSISTANT_MAX_TOKENS=700
ASSISTANT_DAILY_LIMIT=60
ASSISTANT_EVAL_MODELS=

# Platform (operator) requisites — printed on the contract, the invoice and the
# closing acts. Leave empty and the documents show a dash in their place.
LEGAL_TERMS_VERSION=v1
LEGAL_PLATFORM_NAME="«Reklama Bozor» platformasi"
LEGAL_PLATFORM_LEGAL_NAME=
LEGAL_PLATFORM_INN=
LEGAL_PLATFORM_ADDRESS=
LEGAL_PLATFORM_PHONE=
LEGAL_PLATFORM_WORK_HOURS="09:00–18:00"
LEGAL_PLATFORM_EMAIL=support@reklamabozor.uz
LEGAL_PLATFORM_WEBSITE=reklamabozor.uz
LEGAL_PLATFORM_OKED=
# Payee requisites for a bank-transfer invoice
LEGAL_PLATFORM_BANK_NAME=
LEGAL_PLATFORM_BANK_ACCOUNT=
LEGAL_PLATFORM_MFO=
# Where cash is accepted (address + hours), shown on a cash invoice
LEGAL_PLATFORM_CASH_DESK=

# Propusk (Tezkor claim pass). max_active_claims caps open claims per agent
# (default 3, so one agent/bot cannot hoard every fresh request); admin panel
# can override both at runtime.
PASSES_ENFORCE=false
PASSES_MAX_ACTIVE_CLAIMS=3
# Pay-per-otklik (admin: mode = "Har bir otklik uchun"): every Tezkor and Tender
# otklik debits response_price_som from the agent's balance, topped up by card.
# Needs PASSES_ENFORCE=true and PASSES_WALLET_ENABLED=true.
PASSES_WALLET_ENABLED=false

# ATMOS online payments (Propusk). Enable with PASSES_GATEWAY=atmos.
PASSES_GATEWAY=
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
ATMOS_API_KEY=
ATMOS_SIGN_ALGO=md5
ATMOS_INVOICE_TTL=30
ATMOS_SUCCESS_URL=
ATMOS_OFD_CODE=
ATMOS_PACKAGE_CODE=
